{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plans",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": true
  },
  // Production hostname. Requires the `superhighfives.com` zone to be on this
  // Cloudflare account; Workers provisions the DNS record + cert automatically.
  "routes": [{ "pattern": "plans.superhighfives.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plans",
      "database_id": "a325feee-984d-464b-bee9-7c90a984887f",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI binding — Claude calls run through it, routed via the AI Gateway
  // named in CF_AI_GATEWAY_ID. Auth + Unified Billing ride on the account, so no
  // gateway token or Anthropic key is needed. `remote: true` because Workers AI
  // has no local emulation — dev must proxy to the real API (see remoteBindings
  // in vite.config.ts, which authenticates via wrangler login / CLOUDFLARE_*).
  "ai": { "binding": "AI", "remote": true },
  // Flue conversational agent — one Durable Object instance per repo. Agents
  // SDK requires SQLite-backed DOs (new_sqlite_classes).
  //
  // Sandbox — one ephemeral container per verify run (slice 5: "move to done"
  // runs the repo's own test/build scripts before committing). See Dockerfile.
  "durable_objects": {
    "bindings": [
      { "name": "FlueAgent", "class_name": "FlueAgent" },
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  // Long-running verify step (git clone + install + test/build can take
  // minutes) — Workflows checkpoint each step so it survives past a single
  // request instead of racing a Worker's request timeout.
  "workflows": [
    {
      "name": "verify-plan-move",
      "binding": "VERIFY_PLAN_MOVE_WORKFLOW",
      "class_name": "VerifyPlanMoveWorkflow"
    }
  ],
  // Migrations are append-only — each new Durable Object class gets its own
  // tag rather than editing an already-applied one.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FlueAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] }
  ],
  // Secrets (set with `wrangler secret put <NAME>` for production, or in
  // `.dev.vars` for local dev — see .dev.vars.example):
  //   GITHUB_APP_ID, GITHUB_APP_CLIENT_ID, GITHUB_APP_CLIENT_SECRET,
  //   GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET,
  //   SESSION_SECRET, TOKEN_ENCRYPTION_KEY, APP_URL, CF_AI_GATEWAY_ID
  //
  // Stable preview environment (`wrangler deploy --env preview`, or
  // `npm run deploy:preview`) → the `plans-preview` Worker on its own domain,
  // with isolated D1 + DO namespace so any branch can be reviewed live without
  // touching prod. See plans/ready/branch-preview-deploys.md. Named
  // environments do NOT inherit bindings, so they're all redeclared here.
  // One-time: create the D1 (`wrangler d1 create plans-preview`), paste its id
  // below, register the preview OAuth callback, and set `--env preview` secrets.
  "env": {
    "preview": {
      "name": "plans-preview",
      "routes": [
        { "pattern": "plans-preview.superhighfives.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "plans-preview",
          "database_id": "ea4b9f18-e4e8-4cc9-8839-d708a3ee088b",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI", "remote": true },
      "durable_objects": {
        "bindings": [
          { "name": "FlueAgent", "class_name": "FlueAgent" },
          { "name": "Sandbox", "class_name": "Sandbox" }
        ]
      },
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./Dockerfile",
          "instance_type": "lite",
          "max_instances": 1
        }
      ],
      "workflows": [
        {
          "name": "verify-plan-move-preview",
          "binding": "VERIFY_PLAN_MOVE_WORKFLOW",
          "class_name": "VerifyPlanMoveWorkflow"
        }
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["FlueAgent"] },
        { "tag": "v2", "new_sqlite_classes": ["Sandbox"] }
      ]
    }
  }
}
